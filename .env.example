DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_cicd
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434

GROQ_API_KEY=your_groq_api_key
GITHUB_TOKEN=your_github_pat
# Fine-grained PAT for the target repo with repository permission:
# Pull requests: Read
# Contents: Read also works for GET /repos/{owner}/{repo}/pulls/{pull_number}, but Pull requests: Read is the clearest fit.

NEXTAUTH_SECRET=run_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

ORCHESTRATOR_URL=http://localhost:4000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4000

HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=password
