{
  "name": "agentic-cicd",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "turbo run build",
    "start:backend": "pnpm --filter @agentic-cicd/orchestrator dev",
    "start:backend:prod": "pnpm -w -s --filter @agentic-cicd/orchestrator --parallel build && node -r dotenv/config apps/orchestrator/dist/server.js",
    "simulate:mock": "cross-env SIMULATION_MOCK_LLM=true pnpm --filter @agentic-cicd/orchestrator simulate:easy",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "tsx --test apps/**/*.test.ts packages/**/*.test.ts",
    "db:migrate": "corepack pnpm --filter @agentic-cicd/db db:migrate",
    "db:seed": "corepack pnpm --filter @agentic-cicd/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.3",
    "turbo": "^2.1.3",
    "typescript-eslint": "^8.31.1",
    "typescript": "^5.6.3",
    "cross-env": "^7.0.3"
  }

}
